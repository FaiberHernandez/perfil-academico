---
import { site, sections } from "../data/site";
import { members } from "../data/members";

const memberNames = members.map((m) => m.name);
---

<section id="portada" class="relative overflow-hidden" aria-label="Portada">
  <div class="mx-auto max-w-6xl px-5 pt-24 pb-16 md:px-8 md:pt-36 md:pb-24">
    <!-- Editorial masthead -->
    <div class="border-t-2 border-carbon">
      <div
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-carbon/20 py-3"
      >
        <p class="label text-carbon/70">{site.institution.name}</p>
        <p class="label hidden text-carbon/70 md:block">{site.course}</p>
        <p class="label text-carbon/70">{site.date}</p>
      </div>
    </div>

    <div class="mt-14 grid gap-12 md:mt-24 md:grid-cols-12 md:gap-8">
      <!-- Headline -->
      <div class="reveal md:col-span-8">
        <p class="kicker">Portafolio académico — {site.institution.program}</p>
        <h1
          class="mt-5 font-serif text-[clamp(2.6rem,8.5vw,6.5rem)] leading-[1.02] font-medium tracking-tight text-balance"
        >
          <span class="block italic font-light text-blue-deep">Entre letras</span>
          <span class="block">y algoritmos<span
            class="ml-3 inline-block h-[0.82em] w-[0.07em] translate-y-[0.12em] bg-terra animate-blink"
            aria-hidden="true"></span></span>
        </h1>
        <p class="mt-7 max-w-xl font-serif text-lg leading-relaxed text-ink-soft italic md:text-xl">
          {site.subtitle}
        </p>

        <div class="mt-12 flex flex-wrap items-center gap-x-3 gap-y-2" aria-label="Integrantes">
          {
            memberNames.map((name, i) => (
              <>
                <span class="font-serif text-sm md:text-base text-carbon">{name}</span>
                {i < memberNames.length - 1 && <span class="text-terra" aria-hidden="true">·</span>}
              </>
            ))
          }
        </div>

        <a
          href="#identidades"
          class="group mt-12 inline-flex items-center gap-3 label text-carbon"
        >
          <span class="flex size-9 items-center justify-center rounded-full border border-carbon/30 transition-colors group-hover:border-terra group-hover:bg-terra group-hover:text-ivory">
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14m0 0l6-6m-6 6l-6-6"></path>
            </svg>
          </span>
          Descubrir el contenido
        </a>
      </div>

      <!-- Index -->
      <aside class="reveal md:col-span-4" aria-label="Índice de secciones">
        <nav class="border-t-2 border-carbon">
          <p class="label border-b border-carbon/20 py-3">En este número</p>
          <ol class="divide-y divide-line">
            {
              sections.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    class="group flex items-baseline justify-between gap-4 py-4"
                  >
                    <span class="section-number text-2xl text-line transition-colors group-hover:text-terra">
                      {s.number}
                    </span>
                    <span class="flex-1 font-serif text-lg leading-snug group-hover:text-blue-deep">
                      {s.label}
                    </span>
                    <svg
                      class="size-4 text-carbon/30 transition-all group-hover:translate-x-1 group-hover:text-terra"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14m0 0l-6-6m6 6l-6 6" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="mt-8 border-t border-carbon/20 pt-5">
          <p class="label text-carbon/60">Presentado por</p>
          <p class="mt-2 font-serif text-base leading-relaxed">
            {site.membersLabel} · {site.institution.program}
          </p>
          <p class="mt-1 text-sm text-ink-soft">
            {site.institution.faculty}, {site.institution.name}
          </p>
        </div>
      </aside>
    </div>
  </div>

  <!-- Decorative baseline -->
  <div class="pointer-events-none absolute right-0 bottom-0 left-0 h-px bg-carbon/10" aria-hidden="true"></div>
</section>
